# Local-only environment values.
# Copy to .env for development and keep real secrets out of git.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional local Codex CLI provider. Requires codex to already be installed and configured.
CODEX_CLI_COMMAND=codex
# CODEX_CLI_MODEL=your-codex-model
# CODEX_CLI_STRUCTURED_GRAMMAR_PROFILE=portable_v1

# OpenAI-compatible REST endpoint, such as Venice.
REST_BASE_URL=https://api.venice.ai/api/v1
REST_MODEL=your-model-name
REST_API_KEY=replace-me
